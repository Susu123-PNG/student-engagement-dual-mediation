TITLE:  ULMC (unmeasured latent method construct) model (Section 4.1);
DATA:  FILE IS data.dat;
VARIABLE:
  NAMES ARE id gender grade major hukou onlychild cadre class
            ps1-ps16 pcj1-pcj20 ts1-ts17 si1-si15 se1-se18;
  USEVARIABLES ARE ps1-ps16 pcj1-pcj20 ts1-ts17 si1-si15 se1-se18;
  MISSING ARE ALL (99);
ANALYSIS:
  ESTIMATOR = ML;
MODEL:
  ps  BY ps1-ps16*;
  pcj BY pcj1-pcj20*;
  ts  BY ts1-ts17*;
  si  BY si1-si15*;
  se  BY se1-se18*;
  meth BY ps1 ps16 pcj1 pcj20 ts1 ts17 si1 si15 se1 se18*;  ! marker subset
  ps@1 pcj@1 ts@1 si@1 se@1;
  meth@1;
OUTPUT: STDYX RESIDUAL;
! Method factor accounted for 12.4% of the variance; fit change vs. the
! five-factor CFA was negligible (dCFI = .008, dRMSEA = .003).
