TITLE:  one-factor (Harman) model for common method bias (Section 4.1);
DATA:  FILE IS WA227_data.dat;
VARIABLE:
  NAMES ARE id gender grade major hukou onlychild cadre class
            ps1-ps16 pcj1-pcj20 ts1-ts17 si1-si15 se1-se18;
  USEVARIABLES ARE ps1-ps16 pcj1-pcj20 ts1-ts17 si1-si15 se1-se18;
  MISSING ARE ALL (99);
ANALYSIS:
  ESTIMATOR = ML;
MODEL:
  g BY ps1-ps16* pcj1-pcj20* ts1-ts17* si1-si15* se1-se18*;
  g@1;
OUTPUT: STDYX;
! First unrotated factor from the EFA (SPSS section 11) explained 28.6% (< 40%).
